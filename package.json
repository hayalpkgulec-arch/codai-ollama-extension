{
  "name": "codai-ollama-tools",
  "displayName": "CodAI Ollama Tools",
  "description": "AI-powered coding assistant with multi-provider support",
  "version": "0.0.54",
  "publisher": "codai",
  "repository": {
    "type": "git",
    "url": "https://github.com/hayalpkgulec-arch/codai-ollama-extension.git"
  },
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codai-sidebar",
          "title": "CodAI",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "codai-sidebar": [
        {
          "type": "webview",
          "id": "codai.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "codai.chat",
        "title": "CodAI: Open Chat",
        "category": "CodAI"
      },
      {
        "command": "codai.explainCode",
        "title": "CodAI: Bu Kodu Açıkla",
        "category": "CodAI"
      },
      {
        "command": "codai.refactorCode",
        "title": "CodAI: Bu Kodu Refaktör Et",
        "category": "CodAI"
      },
      {
        "command": "codai.checkUpdate",
        "title": "CodAI: Check for Updates",
        "category": "CodAI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codai.explainCode",
          "group": "1_modification@1",
          "when": "editorHasSelection"
        },
        {
          "command": "codai.refactorCode",
          "group": "1_modification@2",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "CodAI",
      "properties": {
        "codai.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL"
        },
        "codai.model": {
          "type": "string",
          "default": "minimax-m2:cloud",
          "description": "Default Ollama model"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile:webview": "cd webview-ui && npm run build",
    "compile:extension": "tsc -p ./",
    "compile": "npm run compile:webview && npm run compile:extension",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "puppeteer-core": "^24.39.0"
  }
}
